VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Server-only secret for universal Atlas Brain and external web search.
# Add it in Vercel Project Settings -> Environment Variables. Never prefix it with VITE_.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
OPENAI_MODEL=gpt-5-mini
OPENAI_SEARCH_MODEL=gpt-5-mini

# Optional server-only secret for direct AUTO.RIA integration.
RIA_API_KEY=YOUR_RIA_API_KEY
