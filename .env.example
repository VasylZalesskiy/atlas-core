VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_PUBLISHABLE_KEY

# Server-only secret for universal Atlas Brain. Add in Vercel Environment Variables.
OPENAI_API_KEY=YOUR_OPENAI_API_KEY
# Optional. Defaults to gpt-5-mini.
OPENAI_MODEL=gpt-5-mini

# Server-only secret for /api/ria-cars. Add in Vercel Environment Variables.
RIA_API_KEY=YOUR_RIA_API_KEY
